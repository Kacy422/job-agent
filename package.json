{
  "name": "job-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./scripts/patch-fs-readlink.js ./node_modules/next/dist/bin/next dev",
    "build": "node -r ./scripts/patch-fs-readlink.js ./node_modules/next/dist/bin/next build",
    "start": "node -r ./scripts/patch-fs-readlink.js ./node_modules/next/dist/bin/next start",
    "lint": "next lint",
    "agent:install": "cd agent && pip install -r requirements.txt && playwright install chromium",
    "agent:dev": "cd agent && uvicorn main:app --reload --port 8000"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "^15.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
