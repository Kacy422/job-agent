DEEPSEEK_API_KEY=sk-your-deepseek-key
AGENT_SERVICE_URL=http://127.0.0.1:8000

# Upstash Redis（Vercel 绑定后会自动注入；本地开发请从 Vercel / Upstash 控制台复制）
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# 兼容 Vercel KV 变量名（二选一即可）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 可选：多工作区隔离 key，默认 default → Redis key = job-agent:workspace:default
# JOB_AGENT_WORKSPACE_ID=default
