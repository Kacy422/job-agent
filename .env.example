DEEPSEEK_API_KEY=sk-your-deepseek-key
AGENT_SERVICE_URL=http://127.0.0.1:8000

# —— Upstash Redis（多端同步的唯一数据源）——
# Vercel 绑定 Upstash Redis / KV 后通常会自动注入；本地请复制到 .env.local
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# 兼容 Vercel KV 变量名（与上面二选一即可）
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 可选：工作区隔离，默认 default → Redis key = job-agent:workspace:default
# JOB_AGENT_WORKSPACE_ID=default
